# Copy to .env — these are read by Vite, so every name must start with VITE_.
# Get both keys from https://dashboard.stripe.com/test/apikeys

# Stripe publishable key (pk_test_...). Must belong to the same Stripe account
# as STRIPE_SECRET_KEY in server/.env.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: base URL of the donation API. Defaults to http://localhost:4242.
# VITE_API_URL=http://localhost:4242
